PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
CLIENT_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

PASSWORD_RESET_OTP_EXPIRES_MINUTES=5

# Nodemailer SMTP settings for password reset OTP email.
# Gmail example:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=your-address@gmail.com
# EMAIL_SMTP_PASS=your-google-app-password
#
# For port 465, set EMAIL_SMTP_SECURE=true.
# For port 587, keep EMAIL_SMTP_SECURE=false so STARTTLS can be used.
# If local antivirus/proxy causes "self-signed certificate in certificate chain",
# set EMAIL_TLS_REJECT_UNAUTHORIZED=false for local development only.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_TLS_REJECT_UNAUTHORIZED=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_NAME=GreenCycle
EMAIL_FROM_ADDRESS=

BCRYPT_SALT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_REWARD_FOLDER=greencycle/rewards
